<%-- This partial renders ONLY the form body.
     The modal shell (div.modal, modal-dialog, modal-content) lives in _Layout.cshtml.
     jQuery is already loaded by _Layout — no script tags needed here. --%>

<div id="loginError"
     style="display: none; font-size: 0.82rem; margin-bottom: 0.75rem;
            color: var(--bob-danger-text);
            background: var(--bob-danger-bg);
            border: 1px solid var(--bob-danger-border);
            border-radius: var(--bob-radius-sm);
            padding: 0.4rem 0.75rem;">
    Invalid username or password. Please try again.
</div>

<div class="mb-3">
    <label class="bob-label" for="loginUsername">Username</label>
    <input class="bob-input" type="text" id="loginUsername" name="username"
           autocomplete="username" required />
</div>

<div class="mb-3">
    <label class="bob-label" for="loginPassword">Password</label>
    <input class="bob-input" type="password" id="loginPassword" name="password"
           autocomplete="current-password" required />
</div>

<div class="d-flex justify-content-between align-items-center mt-1">
    <a asp-controller="Home" asp-action="CreateAccount"
       style="font-size: 0.85rem;">
        Create an account
    </a>
    <div class="d-flex gap-2">
        <button type="button" class="btn bob-btn-outline"
                data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="button" class="btn bob-btn-primary"
                id="logInBtn">
            Log in
        </button>
    </div>
</div>