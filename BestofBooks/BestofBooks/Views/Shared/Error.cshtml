@model BestofBooks.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="bob-hero mb-4"
     style="border-color: var(--bob-danger-border);
            background-color: var(--bob-danger-bg);">
    <div class="d-flex align-items-center gap-3">
        <div style="font-size: 2.5rem; line-height: 1;" aria-hidden="true">&#9888;</div>
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem; color: var(--bob-danger-text);">
                Something went wrong
            </h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                An error occurred while processing your request.
            </p>
        </div>
    </div>
</div>

<div class="bob-card">
    @if (Model.ShowRequestId)
    {
        <p style="font-size: 0.875rem; color: var(--bob-text-muted); margin-bottom: 1rem;">
            <strong style="color: var(--bob-text);">Request ID:</strong>
            <code style="font-family: monospace; color: var(--bob-accent);">
                @Model.RequestId
            </code>
        </p>
        <hr class="bob-divider" />
    }

    <p style="font-size: 0.9rem; color: var(--bob-text-muted); margin-bottom: 1.25rem;">
        This has been logged. If the problem persists, please contact a store administrator.
    </p>

    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="InventoryList"
           class="btn bob-btn-primary">
            &larr; Back to inventory
        </a>
        <button onclick="history.back()"
                class="btn bob-btn-outline">
            Go back
        </button>
    </div>
</div>