@model BestofBooks.Models.ViewModels.BaseViewModel

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BestofBooks</title>

    <%-- Single Bootstrap version — 5.3 only --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">

    <%-- DataTables (Bootstrap 5 theme) --%>
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <%-- Google Fonts: Inter (body) + Syne (brand/headings) --%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <%-- Theme init runs before paint to prevent flash of wrong theme --%>
    <script>
        (function () {
            const saved = localStorage.getItem('bob-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
</head>

<body>
    <%-- ── NAVBAR ── --%>
    <nav class="bob-nav navbar navbar-expand-md" id="mainNav">
        <div class="container">

            <%-- Brand --%>
            <a class="navbar-brand bob-brand" asp-controller="Home" asp-action="InventoryList">
                <span class="bob-ball" aria-hidden="true">&#9899;</span>
                BestofBooks
            </a>

            <%-- Mobile toggle --%>
            <button class="navbar-toggler bob-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navCollapse"
                    aria-controls="navCollapse" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navCollapse">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item">
                        <a class="nav-link bob-link" asp-controller="Home" asp-action="InventoryList">Inventory</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link bob-link" asp-controller="Home" asp-action="Search">Search</a>
                    </li>

                    @if (Model.LoggedInUser != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link bob-link" asp-controller="Home" asp-action="Reports">Reports</a>
                        </li>
                    }

                    @if (Model.LoggedInUser != null && Model.LoggedInUser.is_Admin)
                    {
                        <li class="nav-item">
                            <a class="nav-link bob-link" asp-controller="Home" asp-action="Admin">Admin</a>
                        </li>
                    }
                </ul>

                <%-- Right side: theme toggle + auth --%>
                <div class="d-flex align-items-center gap-3">

                    <%-- Dark / light toggle --%>
                    <button class="bob-theme-toggle" id="themeToggle"
                            aria-label="Toggle dark/light mode" title="Toggle theme">
                        <span class="icon-moon" aria-hidden="true">&#9790;</span>
                        <span class="icon-sun" aria-hidden="true">&#9728;</span>
                    </button>

                    @if (Model.LoggedInUser is null)
                    {
                        <a class="btn bob-btn-outline" data-bs-toggle="modal" data-bs-target="#loginModal">
                            Log in
                        </a>
                        <a class="btn bob-btn-primary" asp-controller="Home" asp-action="CreateAccount">
                            Sign up
                        </a>
                    }
                    else
                    {
                        <span class="bob-user-pill">
                            @Model.LoggedInUser.username
                        </span>
                        <form asp-controller="Home" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="btn bob-btn-outline">Log out</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>

    <%-- ── PAGE BODY ── --%>
    <main class="container py-4" role="main">
        @RenderBody()
    </main>

    <%-- ── FOOTER ── --%>
    <footer class="bob-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center py-3">
            <span class="bob-footer-brand">
                <span class="bob-ball" aria-hidden="true">&#9899;</span>
                BestofBooks &copy; @DateTime.Now.Year
            </span>
            <nav aria-label="Footer navigation">
                <a asp-controller="Home" asp-action="Privacy" class="bob-footer-link">Privacy</a>
            </nav>
        </div>
    </footer>

    <%-- ── LOGIN MODAL ── --%>
    <div class="modal fade" id="loginModal" tabindex="-1"
         aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bob-modal">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title bob-modal-title" id="loginModalLabel">
                        <span class="bob-ball" aria-hidden="true">&#9899;</span> Log in
                    </h5>
                    <button type="button" class="btn-close bob-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    @Html.AntiForgeryToken()
                    @await Html.PartialAsync("Login")
                </div>
            </div>
        </div>
    </div>

    <%-- ── SCRIPTS ── --%>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmL14Gnl/9CKqNH5JwMY1zeI/jJ"
            crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>

    <%-- Theme toggle — full script stays here since it needs the button --%>
    <script>
        document.getElementById('themeToggle').addEventListener('click', function () {
            const html = document.documentElement;
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('bob-theme', next);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>