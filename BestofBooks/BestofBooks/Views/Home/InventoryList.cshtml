@{
    ViewData["Title"] = "Inventory";
}
@model BestofBooks.Models.ViewModels.InventoryListViewModel

<div class="bob-hero mb-4">
    <div class="d-flex align-items-center gap-3 mb-2">
        <img src="@Url.Content("~/Images/BestofBooks2.png")"
             alt="BestofBooks logo"
             style="height: 3rem; width: auto;" />
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem;">Pool &amp; Billiards Books &amp; DVDs</h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                Browse our full inventory below. Ask an employee for help finding anything.
            </p>
        </div>
    </div>

    <div class="bob-stat-bar mt-3">
        <div class="bob-stat-cell">
            <div class="bob-stat-num">@Model.invListBooks.Count()</div>
            <div class="bob-stat-label">Total titles</div>
        </div>
        <div class="bob-stat-cell">
            <div class="bob-stat-num">@Model.invListBooks.Count(b => b.Quantity > 0 && b.Quantity <= 3)</div>
            <div class="bob-stat-label">Low stock</div>
        </div>
        <div class="bob-stat-cell">
            <div class="bob-stat-num">@Model.invListBooks.Count(b => b.Quantity == 0)</div>
            <div class="bob-stat-label">Out of stock</div>
        </div>
    </div>
</div>

@if (Model.LoggedInUser != null && Model.LoggedInUser.adds_enabled)
{
    <div class="bob-card mb-4">
        <h2 class="mb-3" style="font-size: 1.1rem;">
            <span class="bob-ball" aria-hidden="true">&#9899;</span> Add new title
        </h2>
        <form method="post" id="addBookForm">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <label class="bob-label" for="new_ISBN">ISBN</label>
                    <input class="bob-input" id="new_ISBN" name="newBook.ISBN" type="text" placeholder="978-..." />
                </div>
                <div class="col-12 col-md-3">
                    <label class="bob-label" for="new_title">Title</label>
                    <input class="bob-input" id="new_title" name="newBook.Title" type="text" placeholder="Book or DVD title" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="bob-label" for="new_authorFirst">Author first</label>
                    <input class="bob-input" id="new_authorFirst" name="newBook.AuthorFirst" type="text" placeholder="First name" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="bob-label" for="new_authorLast">Author last</label>
                    <input class="bob-input" id="new_authorLast" name="newBook.AuthorLast" type="text" placeholder="Last name" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="bob-label" for="new_genre">Genre</label>
                    <input class="bob-input" id="new_genre" name="newBook.Genre" type="text" placeholder="e.g. Instruction" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="bob-label" for="new_location">Shelf</label>
                    <input class="bob-input" id="new_location" name="newBook.Location" type="text" placeholder="A-1" />
                </div>
                <div class="col-4 col-md-1">
                    <label class="bob-label" for="new_price">Price</label>
                    <input class="bob-input" id="new_price" name="newBook.Price" type="text"
                           inputmode="numeric" pattern="[0-9]+([\.,][0-9]+)?" placeholder="0.00" />
                </div>
                <div class="col-4 col-md-1">
                    <label class="bob-label" for="new_qty">Qty</label>
                    <input class="bob-input" id="new_qty" name="newBook.Quantity" type="number"
                           min="0" placeholder="0" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" name="Add" class="btn bob-btn-primary">
                    + Add title
                </button>
            </div>
        </form>
    </div>
}

<div class="bob-card p-0" style="overflow: hidden;">
    <div style="overflow-x: auto;">
        <table class="bob-table" id="ListTable">
            <thead>
                <tr>
                    <th>ISBN</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Shelf</th>
                    <th>Price</th>
                    <th>Stock</th>
                    @if (Model.LoggedInUser != null && Model.LoggedInUser.edits_enabled)
                    {
                        <th><span class="visually-hidden">Actions</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.invListBooks.Count(); i++)
                {
                    var book = Model.invListBooks[i];
                    var stockClass = book.Quantity == 0 ? "bob-badge-danger"
                    : book.Quantity <= 3 ? "bob-badge-warn"
                    : "bob-badge-success";
                    var stockLabel = book.Quantity == 0 ? "Out of stock"
                    : book.Quantity <= 3 ? $"Low · {book.Quantity}"
                    : $"In stock · {book.Quantity}";

                    <tr>
                        <td id="invListISBN-@book.Id"
                            style="font-size:0.8rem; color: var(--bob-text-muted); font-family: monospace;">
                            @book.ISBN
                        </td>
                        <td id="invListTitle-@book.Id" style="font-weight: 500;">
                            @book.Title
                        </td>
                        <td id="invListAuthor-@book.Id">
                            @book.AuthorFirst @book.AuthorLast
                        </td>
                        <td id="invListGenre-@book.Id"
                            style="font-size: 0.85rem; color: var(--bob-text-muted);">
                            @book.Genre
                        </td>
                        <td id="invListLocation-@book.Id">
                            <span class="bob-badge" style="background: var(--bob-surface-2);
                                      border-color: var(--bob-border); color: var(--bob-accent);
                                      font-family: monospace;">
                                @book.Location
                            </span>
                        </td>
                        <td id="invListPrice-@book.Id" style="font-weight: 500;">
                            $@book.Price.ToString("0.00")
                        </td>
                        <td id="invListQty-@book.Id">
                            <span class="bob-badge @stockClass">@stockLabel</span>
                        </td>
                        @if (Model.LoggedInUser != null && Model.LoggedInUser.edits_enabled)
                        {
                            <td>
                                <button type="button"
                                        class="btn bob-btn-outline"
                                        style="font-size: 0.75rem; padding: 0.2rem 0.65rem;"
                                        id="edit_btn_@book.Id"
                                        onclick="edit_row(@book.Id)"
                                        aria-label="Edit @book.Title">
                                    Edit
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.LoggedInUser != null && Model.LoggedInUser.edits_enabled)
{
    <div class="modal fade" id="editDialog" tabindex="-1"
         aria-labelledby="editDialogLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bob-modal">
                <form action="/Home/InventoryListUpdate" method="post">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title bob-modal-title" id="editDialogLabel">
                            <span class="bob-ball" aria-hidden="true">&#9899;</span> Edit title
                        </h5>
                        <button type="button" class="btn-close bob-close"
                                data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="edit_Id" name="editBook.Id" value="0" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="bob-label" for="edit_ISBN">ISBN</label>
                                <input class="bob-input" id="edit_ISBN" name="editBook.ISBN" type="text" />
                            </div>
                            <div class="col-12">
                                <label class="bob-label" for="edit_title">Title</label>
                                <input class="bob-input" id="edit_title" name="editBook.Title" type="text" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_authorFirst">Author first name</label>
                                <input class="bob-input" id="edit_authorFirst" name="editBook.AuthorFirst" type="text" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_authorLast">Author last name</label>
                                <input class="bob-input" id="edit_authorLast" name="editBook.AuthorLast" type="text" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_genre">Genre</label>
                                <input class="bob-input" id="edit_genre" name="editBook.Genre" type="text" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_location">Shelf location</label>
                                <input class="bob-input" id="edit_location" name="editBook.Location" type="text" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_price">Price</label>
                                <input class="bob-input" id="edit_price" name="editBook.Price"
                                       type="text" inputmode="numeric"
                                       pattern="[0-9]+([\.,][0-9]+)?" placeholder="0.00" />
                            </div>
                            <div class="col-6">
                                <label class="bob-label" for="edit_qty">Quantity</label>
                                <input class="bob-input" id="edit_qty" name="editBook.Quantity"
                                       type="number" min="0" placeholder="0" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn bob-btn-outline"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button id="saveBtn" class="btn bob-btn-primary"
                                type="submit" name="editSave">
                            Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            $('#ListTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });
    </script>
    <script src="~/js/inventoryList.js" asp-append-version="true"></script>
}