@{
    ViewData["Title"] = "Change History Report";
}
@model BestofBooks.Models.ViewModels.ChangeHistoryReportViewModel

<div class="bob-hero mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="@Url.Content("~/Images/BestofBooks2.png")"
             alt="BestofBooks logo"
             style="height: 3rem; width: auto;" />
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem;">Change history report</h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                Audit log of all inventory changes. Admin access only.
            </p>
        </div>
    </div>
</div>

<div class="bob-card mb-4">
    <form method="post" id="reportFilterForm">
        <div class="row g-2 align-items-end">

            <div class="col-12 col-md-3">
                <label class="bob-label" for="chrUsername">Username</label>
                <select class="bob-input"
                        id="chrUsername"
                        name="UsernameFilter"
                        asp-items="@Model.DimUsernames">
                    <option value="">All users</option>
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="bob-label" for="chrLastname">Last name</label>
                <select class="bob-input"
                        id="chrLastname"
                        name="LastnameFilter"
                        asp-items="@Model.DimLastnames">
                    <option value="">All last names</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="bob-label" for="beginDate">From date</label>
                <input class="bob-input"
                       type="date"
                       id="beginDate"
                       name="StartDate"
                       value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-6 col-md-2">
                <label class="bob-label" for="endDate">To date</label>
                <input class="bob-input"
                       type="date"
                       id="endDate"
                       name="EndDate"
                       value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-12 col-md-2">
                <button type="submit"
                        class="btn bob-btn-primary w-100"
                        id="SearchBtn">
                    Run report
                </button>
            </div>

        </div>

        <div id="dateError"
             class="mt-2"
             style="display: none; font-size: 0.82rem;
                    color: var(--bob-danger-text);
                    background: var(--bob-danger-bg);
                    border: 1px solid var(--bob-danger-border);
                    border-radius: var(--bob-radius-sm);
                    padding: 0.4rem 0.75rem;">
            End date cannot be before start date.
        </div>

    </form>
</div>

@if (Model.Results != null)
{
    @if (!Model.Results.Any())
    {
        <div class="bob-card text-center py-5" style="color: var(--bob-text-muted);">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;" aria-hidden="true">&#9899;</div>
            <p class="mb-1" style="font-weight: 500; color: var(--bob-text);">No changes found</p>
            <p style="font-size: 0.9rem;">Try a wider date range or remove a user filter.</p>
        </div>
    }
    else
    {
        <div class="bob-card p-0 mb-3" style="overflow: hidden;" id="printArea">

            <div class="d-flex align-items-center justify-content-between px-4 py-3"
                 style="border-bottom: 1px solid var(--bob-border);">
                <span style="font-size: 0.85rem; color: var(--bob-text-muted);">
                    <span style="font-weight: 600; color: var(--bob-accent);">
                        @Model.Results.Count()
                    </span>
                    change record@(Model.Results.Count() == 1 ? "" : "s") found
                </span>
                <button type="button"
                        class="btn bob-btn-outline"
                        style="font-size: 0.8rem; padding: 0.25rem 0.75rem;"
                        onclick="printReport()">
                    &#128438; Print report
                </button>
            </div>

            <div style="overflow-x: auto;">
                <table class="bob-table" id="ListTable">
                    <thead>
                        <tr>
                            <th>Table</th>
                            <th>Action</th>
                            <th>Changed by</th>
                            <th>Date &amp; time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Results)
                        {
                            var actionClass = row.Action?.ToLower() switch
                            {
                                "insert" or "add" => "bob-badge-success",
                                "delete" or "remove" => "bob-badge-danger",
                                "update" or "edit" => "bob-badge-warn",
                                _ => ""
                            };

                            <tr>
                                <td style="font-family: monospace; font-size: 0.82rem;
                                                       color: var(--bob-text-muted);">
                                    @row.TableName
                                </td>
                                <td>
                                    <span class="bob-badge @actionClass">@row.Action</span>
                                </td>
                                <td style="font-weight: 500;">@row.ModifiedBy</td>
                                <td style="font-size: 0.85rem; color: var(--bob-text-muted);">
                                    @row.Modified?.ToString("MMM d, yyyy  h:mm tt")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            @if (Model.Results != null && Model.Results.Any())
            {
                    <text>
                    $('#ListTable').DataTable({
                        pageLength: 25,
                        order: [[3, 'desc']],
                        columnDefs: [{ orderable: false, targets: -1 }]
                    });
                    </text>
            }

            $('#reportFilterForm').on('submit', function (e) {
                const start = document.getElementById('beginDate').value;
                const end   = document.getElementById('endDate').value;
                const err   = document.getElementById('dateError');

                if (start && end && end < start) {
                    e.preventDefault();
                    err.style.display = 'block';
                    document.getElementById('endDate').focus();
                } else {
                    err.style.display = 'none';
                }
            });
        });

        function printReport() {
            const printContents = document.getElementById('printArea').innerHTML;
            const win = window.open('', '_blank');
            win.document.write(`
                <html>
                <head>
                    <title>BestofBooks — Change History Report</title>
                    <style>
                        body { font-family: sans-serif; font-size: 13px; color: #000; }
                        table { width: 100%; border-collapse: collapse; }
                        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
                        th { background: #f0f0f0; font-weight: 600; }
                        button { display: none; }
                    </style>
                </head>
                <body>${printContents}</body>
                </html>
            `);
            win.document.close();
            win.focus();
            win.print();
            win.close();
        }
    </script>
}