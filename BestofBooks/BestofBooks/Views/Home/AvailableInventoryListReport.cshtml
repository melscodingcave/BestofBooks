@{
    ViewData["Title"] = "Inventory Report";
}
@model BestofBooks.Models.ViewModels.AvailableReportViewModel

<div class="bob-hero mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="@Url.Content("~/Images/BestofBooks2.png")"
             alt="BestofBooks logo"
             style="height: 3rem; width: auto;" />
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem;">Inventory list report</h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                Filter available inventory by genre, author, or stock status.
            </p>
        </div>
    </div>
</div>

<div class="bob-card mb-4">
    <form method="post" id="reportFilterForm">
        <div class="row g-2 align-items-end">

            <div class="col-12 col-md-3">
                <label class="bob-label" for="irGenre">Genre</label>
                <select class="bob-input"
                        name="BookFilters.Genre"
                        id="irGenre"
                        asp-items="@Model.bookGenres">
                    <option value="">All genres</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="bob-label" for="irAuthor">Author</label>
                <input class="bob-input"
                       type="text"
                       id="irAuthor"
                       name="BookFilters.Author"
                       list="authorOptions"
                       placeholder="Type to search authors..."
                       autocomplete="off" />
                <datalist id="authorOptions">
                    @foreach (var a in Model.bookAuthors)
                    {
                        <option value="@a.Text">@a.Text</option>
                    }
                </datalist>
            </div>

            <div class="col-12 col-md-3">
                <label class="bob-label" for="irInStock">Stock status</label>
                <select class="bob-input"
                        name="BookFilters.Stock"
                        id="irInStock">
                    <option value="all">All</option>
                    <option value="instock">In stock</option>
                    <option value="outofstock">Out of stock</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <button type="submit"
                        id="SearchBtn"
                        name="inventoryReportSearchBtn"
                        class="btn bob-btn-primary w-100">
                    Run report
                </button>
            </div>

        </div>
    </form>
</div>

@if (Model.listBooks != null)
{
    @if (Model.listBooks.Count == 0)
    {
        <div class="bob-card text-center py-5" style="color: var(--bob-text-muted);">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;" aria-hidden="true">&#9899;</div>
            <p class="mb-1" style="font-weight: 500; color: var(--bob-text);">No titles match those filters</p>
            <p style="font-size: 0.9rem;">Try broadening your selection or clearing a filter.</p>
        </div>
    }
    else
    {
        <div class="bob-card p-0 mb-3" style="overflow: hidden;" id="printArea">
            <div class="d-flex align-items-center justify-content-between px-4 py-3"
                 style="border-bottom: 1px solid var(--bob-border);">
                <span style="font-size: 0.85rem; color: var(--bob-text-muted);">
                    <span style="font-weight: 600; color: var(--bob-accent);">
                        @Model.listBooks.Count
                    </span>
                    title@(Model.listBooks.Count == 1 ? "" : "s") found
                </span>
                <button type="button"
                        class="btn bob-btn-outline"
                        style="font-size: 0.8rem; padding: 0.25rem 0.75rem;"
                        onclick="printReport()"
                        id="PrintBtn">
                    &#128438; Print report
                </button>
            </div>

            <div style="overflow-x: auto;">
                <table class="bob-table" id="ListTable">
                    <thead>
                        <tr>
                            <th>ISBN</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Shelf</th>
                            <th>Price</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.listBooks)
                        {
                            var stockClass = book.Quantity == 0 ? "bob-badge-danger"
                            : book.Quantity <= 3 ? "bob-badge-warn"
                            : "bob-badge-success";
                            var stockLabel = book.Quantity == 0 ? "Out of stock"
                            : book.Quantity <= 3 ? $"Low · {book.Quantity}"
                            : $"In stock · {book.Quantity}";

                            <tr>
                                <td style="font-size: 0.8rem; color: var(--bob-text-muted); font-family: monospace;">
                                    @book.ISBN
                                </td>
                                <td style="font-weight: 500;">@book.Title</td>
                                <td>@book.AuthorFirst @book.AuthorLast</td>
                                <td style="font-size: 0.85rem; color: var(--bob-text-muted);">@book.Genre</td>
                                <td>
                                    <span class="bob-badge"
                                          style="background: var(--bob-surface-2);
                                                             border-color: var(--bob-border);
                                                             color: var(--bob-accent);
                                                             font-family: monospace;">
                                        @book.Location
                                    </span>
                                </td>
                                <td style="font-weight: 500;">$@book.Price.ToString("0.00")</td>
                                <td><span class="bob-badge @stockClass">@stockLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            @if (Model.listBooks != null && Model.listBooks.Count > 0)
            {
                    <text>
                    $('#ListTable').DataTable({
                        pageLength: 25,
                        order: [[1, 'asc']],
                        columnDefs: [{ orderable: false, targets: -1 }]
                    });
                    </text>
            }
        });

        function printReport() {
            const printContents = document.getElementById('printArea').innerHTML;
            const win = window.open('', '_blank');
            win.document.write(`
                <html>
                <head>
                    <title>BestofBooks — Inventory Report</title>
                    <style>
                        body { font-family: sans-serif; font-size: 13px; color: #000; }
                        table { width: 100%; border-collapse: collapse; }
                        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
                        th { background: #f0f0f0; font-weight: 600; }
                        button { display: none; }
                    </style>
                </head>
                <body>${printContents}</body>
                </html>
            `);
            win.document.close();
            win.focus();
            win.print();
            win.close();
        }
    </script>
}