@{
    ViewData["Title"] = "Search";
}
@model BestofBooks.Models.ViewModels.SearchViewModel

<div class="bob-hero mb-4">
    <div class="d-flex align-items-center gap-3 mb-1">
        <img src="@Url.Content("~/Images/BestofBooks2.png")"
             alt="BestofBooks logo"
             style="height: 3rem; width: auto;" />
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem;">Search the catalog</h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                Find books and DVDs by title, author, or genre.
            </p>
        </div>
    </div>
</div>

<div class="bob-card mb-4">
    <form method="post" id="searchForm">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="bob-label" for="searchOptions">Search by</label>
                <select class="bob-input"
                        name="FilterType"
                        id="searchOptions"
                        asp-for="FilterType">
                    <option value="" disabled selected>Select a filter...</option>
                    <option value="Title">Title</option>
                    <option value="Genre">Genre</option>
                    <option value="LastName">Author last name</option>
                    <option value="FirstName">Author first name</option>
                </select>
            </div>

            <div class="col-12 col-md-7">
                <label class="bob-label" for="textFilter">Search term</label>
                <input class="bob-input"
                       type="text"
                       id="textFilter"
                       asp-for="Query"
                       name="Query"
                       maxlength="100"
                       placeholder="e.g. Efren Reyes, cue ball control, instructional..." />
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn bob-btn-primary w-100">Search</button>
                <button type="button"
                        class="btn bob-btn-outline"
                        onclick="clearFilters()"
                        aria-label="Clear search">
                    Clear
                </button>
            </div>
        </div>
    </form>
</div>

@if (Model.Results != null)
{
    @if (Model.Results.Count == 0)
    {
        <div class="bob-card text-center py-5" style="color: var(--bob-text-muted);">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;" aria-hidden="true">&#9899;</div>
            <p class="mb-1" style="font-weight: 500; color: var(--bob-text);">No results found</p>
            <p style="font-size: 0.9rem;">
                Try a different search term or filter, or
                <a asp-controller="Home" asp-action="InventoryList">browse the full inventory</a>.
            </p>
        </div>
    }
    else
    {
        <div class="bob-card p-0 mb-4" style="overflow: hidden;">
            <div class="d-flex align-items-center justify-content-between px-4 py-3"
                 style="border-bottom: 1px solid var(--bob-border);">
                <span style="font-size: 0.85rem; color: var(--bob-text-muted);">
                    <span style="font-weight: 600; color: var(--bob-accent);">
                        @Model.Results.Count
                    </span>
                    result@(Model.Results.Count == 1 ? "" : "s") for
                    &ldquo;<strong>@Model.Query</strong>&rdquo;
                </span>
                <a asp-controller="Home" asp-action="InventoryList"
                   style="font-size: 0.8rem;">
                    Browse all &rarr;
                </a>
            </div>

            <div style="overflow-x: auto;">
                <table class="bob-table" id="ListTable">
                    <thead>
                        <tr>
                            <th>ISBN</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Shelf</th>
                            <th>Price</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Results)
                        {
                            var stockClass = book.Quantity == 0 ? "bob-badge-danger"
                            : book.Quantity <= 3 ? "bob-badge-warn"
                            : "bob-badge-success";
                            var stockLabel = book.Quantity == 0 ? "Out of stock"
                            : book.Quantity <= 3 ? $"Low · {book.Quantity}"
                            : $"In stock · {book.Quantity}";

                            <tr>
                                <td style="font-size: 0.8rem; color: var(--bob-text-muted); font-family: monospace;">
                                    @book.ISBN
                                </td>
                                <td style="font-weight: 500;">@book.Title</td>
                                <td>@book.AuthorFirst @book.AuthorLast</td>
                                <td style="font-size: 0.85rem; color: var(--bob-text-muted);">@book.Genre</td>
                                <td>
                                    <span class="bob-badge"
                                          style="background: var(--bob-surface-2);
                                                             border-color: var(--bob-border);
                                                             color: var(--bob-accent);
                                                             font-family: monospace;">
                                        @book.Location
                                    </span>
                                </td>
                                <td style="font-weight: 500;">$@book.Price.ToString("0.00")</td>
                                <td>
                                    <span class="bob-badge @stockClass">@stockLabel</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function clearFilters() {
            document.getElementById('searchOptions').value = '';
            document.getElementById('textFilter').value = '';
        }

        @if (Model.Results != null && Model.Results.Count > 0)
        {
                <text>
                $(document).ready(function () {
                    $('#ListTable').DataTable({
                        pageLength: 25,
                        order: [[1, 'asc']],
                        searching: false,
                        info: false
                    });
                });
                </text>
        }
    </script>
}