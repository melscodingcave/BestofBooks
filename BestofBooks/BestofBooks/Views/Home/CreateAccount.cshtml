@{
    ViewData["Title"] = "Create Account";
}
@model BestofBooks.Models.ViewModels.CreateAccountViewModel

<div class="bob-hero mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="@Url.Content("~/Images/BestofBooks2.png")"
             alt="BestofBooks logo"
             style="height: 3rem; width: auto;" />
        <div>
            <h1 class="mb-0" style="font-size: 1.6rem;">Create an account</h1>
            <p class="mb-0" style="color: var(--bob-text-muted); font-size: 0.9rem;">
                Already have one? <a data-bs-toggle="modal" data-bs-target="#loginModal">Log in here.</a>
            </p>
        </div>
    </div>
</div>

<div class="bob-card" style="max-width: 520px;">
    <form asp-controller="Home" asp-action="CreateAccount" method="post" id="createAccountForm">

        <div class="row g-3">
            <div class="col-6">
                <label class="bob-label" for="firstName">First name</label>
                <input class="bob-input" type="text" id="firstName"
                       asp-for="UserToCreate.user_first" required
                       autocomplete="given-name" />
                <span asp-validation-for="UserToCreate.user_first"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
            </div>
            <div class="col-6">
                <label class="bob-label" for="lastName">Last name</label>
                <input class="bob-input" type="text" id="lastName"
                       asp-for="UserToCreate.user_last" required
                       autocomplete="family-name" />
                <span asp-validation-for="UserToCreate.user_last"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
            </div>

            <div class="col-12">
                <label class="bob-label" for="email">Email address</label>
                <input class="bob-input" type="email" id="email"
                       asp-for="UserToCreate.user_email" required
                       autocomplete="email" />
                <span asp-validation-for="UserToCreate.user_email"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
            </div>

            <div class="col-12">
                <label class="bob-label" for="username">Username</label>
                <input class="bob-input" type="text" id="username"
                       asp-for="UserToCreate.username" required
                       autocomplete="username" />
                <span asp-validation-for="UserToCreate.username"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
            </div>

            <div class="col-12">
                <label class="bob-label" for="password">Password</label>
                <input class="bob-input" type="password" id="password"
                       asp-for="UserToCreate.password" required
                       autocomplete="new-password"
                       minlength="8" />
                <span asp-validation-for="UserToCreate.password"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
                <div style="font-size: 0.75rem; color: var(--bob-text-muted); margin-top: 0.25rem;">
                    Minimum 8 characters.
                </div>
            </div>

            <div class="col-12">
                <label class="bob-label" for="confirmPassword">Confirm password</label>
                <input class="bob-input" type="password" id="confirmPassword"
                       autocomplete="new-password" required />
                <div id="passwordMismatch"
                     style="display:none; font-size:0.78rem; color: var(--bob-danger-text); margin-top:0.25rem;">
                    Passwords do not match.
                </div>
            </div>

            <div class="col-12">
                <label class="bob-label" for="userType">Account type</label>
                <select class="bob-input" id="userType"
                        asp-for="UserToCreate.user_type" required>
                    <option value="guest">Guest</option>
                    <option value="employee">Employee</option>
                </select>
                <span asp-validation-for="UserToCreate.user_type"
                      style="font-size:0.78rem; color: var(--bob-danger-text);"></span>
            </div>
        </div>

        <hr class="bob-divider" />

        <div class="d-flex gap-2">
            <button type="submit" id="createAccountBtn" class="btn bob-btn-primary">
                Create account
            </button>
            <a asp-controller="Home" asp-action="InventoryList"
               class="btn bob-btn-outline">
                Cancel
            </a>
        </div>

    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Client-side password confirmation check
        const form       = document.getElementById('createAccountForm');
        const pw         = document.getElementById('password');
        const confirm    = document.getElementById('confirmPassword');
        const mismatch   = document.getElementById('passwordMismatch');

        form.addEventListener('submit', function (e) {
            if (pw.value !== confirm.value) {
                e.preventDefault();
                mismatch.style.display = 'block';
                confirm.focus();
            } else {
                mismatch.style.display = 'none';
            }
        });

        confirm.addEventListener('input', function () {
            mismatch.style.display = pw.value && confirm.value && pw.value !== confirm.value
                ? 'block' : 'none';
        });
    </script>
}